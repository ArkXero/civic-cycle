    "@llamaindex/liteparse": "2.11.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^25",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
