{
  "name": "civic-cycle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "check": "vp check && vp run lint",
    "test": "vp test",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "benchmark:manifest": "tsx scripts/build-boarddocs-benchmark-manifest.ts",
    "benchmark:parsers": "tsx scripts/benchmark-parsers.ts",
    "benchmark:llamaindex": "python3 workers/llamaindex/worker.py",
    "backfill:boarddocs:dry-run": "tsx --env-file=.env.local scripts/backfill-boarddocs-motions.ts --dry-run"
  },
  "dependencies": {
